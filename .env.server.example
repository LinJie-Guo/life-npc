# Copy to .env.server; never commit real passwords.
MYSQL_ROOT_PASSWORD=replace-with-random-root-password
MYSQL_PASSWORD=replace-with-random-app-password
MYSQL_URL=mysql://life_npc:replace-with-random-app-password@127.0.0.1:3308/life_npc
MYSQL_SSL=false
API_PORT=8788
API_HOST=127.0.0.1
APP_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8788
COOKIE_SECURE=false
AMAP_JS_KEY=
AMAP_SECURITY_CODE=
